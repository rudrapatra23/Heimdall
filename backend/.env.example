# ─── Supabase JS client (Auth / JWT validation) ───────────────────────────────
# HTTPS project URL — NOT the postgres connection string
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ─── PostgreSQL via Drizzle ORM ───────────────────────────────────────────────
# Transaction-mode pooler — used by the app at runtime (Drizzle)
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Session-mode pooler — used by drizzle-kit for migrations only
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Telegram Bot (@BotFather) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF...
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_WEBHOOK_SECRET=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# URL this backend is reachable at (used by the Telegram bot for internal calls)
# Local dev:   http://localhost:4000
# Production:  https://heimdall-backend.yourdomain.com
WORKER_URL=http://localhost:4000

# ─── Gmail SMTP (admin notification email) ────────────────────────────────────
# Requires 2-Step Verification + an App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# From: address — must be your GMAIL_USER address; a display name is allowed.
EMAIL_FROM=Sery <you@gmail.com>
# Where "new applicant" notification emails are sent (your own inbox is fine)
ADMIN_EMAIL=you@gmail.com