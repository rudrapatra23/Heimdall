# ─── Copy this file to .env and fill in the values ───────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ── PostgreSQL via Drizzle ORM ────────────────────────────────────────────────
# Transaction-mode pooler — used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Session-mode pooler — used by drizzle-kit for migrations only
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── Telegram Bot (@BotFather) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF...
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_WEBHOOK_SECRET=
